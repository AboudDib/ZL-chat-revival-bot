# ─── ReviveBot Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ── Discord Bot Credentials (Required) ──────────────────────────────────────────
# Get these from https://discord.com/developers/applications

# Your bot's token (keep this SECRET)
DISCORD_TOKEN=your_discord_bot_token_here

# Your bot's application/client ID (safe to share)
DISCORD_CLIENT_ID=your_discord_client_id_here

# ── Groq AI API Key (Optional but recommended) ────────────────────────────────
# Get yours free at https://console.groq.com
# If omitted, the bot uses built-in fallback messages instead of AI generation.
GROQ_API_KEY=your_groq_api_key_here

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=production
