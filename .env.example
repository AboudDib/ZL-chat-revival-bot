# ─── ReviveBot Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# ── Discord Bot Credentials (Required) ──────────────────────────────────────────
# Get these from https://discord.com/developers/applications

# Your bot's token (keep this SECRET)
DISCORD_TOKEN=your_discord_bot_token_here

# Your bot's application/client ID (safe to share)
DISCORD_CLIENT_ID=your_discord_client_id_here

# Optional: set this to register slash commands to ONE specific server
# instead of globally. Guild-scoped commands appear instantly; global
# commands can take up to an hour to propagate. Remove/unset this once
# the bot is in multiple servers, then redeploy to re-register globally.
DISCORD_GUILD_ID=your_server_id_here

# ── AI API Keys ──────────────────────────────────────────────────────────────
# Gemini is the primary provider — revival questions are grounded in live
# Google Search, so they can reference real current events.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq is used as a fallback if Gemini fails or isn't configured (static
# topics only, no web access). Optional but recommended as a safety net.
# Get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# If neither key is set, the bot skips AI generation and won't send revivals.

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=production
